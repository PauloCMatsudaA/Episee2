# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── WhatsApp (Meta Cloud API) ──────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=EAA...
WHATSAPP_PHONE_NUMBER_ID=123456789
WHATSAPP_VERIFY_TOKEN=meu_token_secreto

# ── Telegram ───────────────────────────────────────────────────────────────────
# Obtenha o token criando um bot com o @BotFather no Telegram
TELEGRAM_BOT_TOKEN=1234567890:AAF...

# URL pública do servidor (necessário para configurar o webhook do Telegram)
# Exemplo: https://meuapp.railway.app
TELEGRAM_WEBHOOK_URL=https://seu-servidor.com

# ── Configurações gerais ───────────────────────────────────────────────────────
ENV=development
